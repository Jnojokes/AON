# Archivio media originale (~1.6 GB) — NON deve andare su GitHub.
# Contiene video oltre i 100 MB che farebbero fallire il push.
asset/

# Video pesanti ovunque (limite GitHub 100 MB/file → hosting esterno)
*.mp4
*.mov
*.MP4
*.MOV

# macOS
.DS_Store
**/.DS_Store

# Node
node_modules/

# Vercel
.vercel/

# Cartella di lavoro: originali ad alta risoluzione dei clienti.
# Non è un asset del sito (escluso anche da .vercelignore e robots.txt) e non
# deve stare in un repository, tantomeno pubblico.
POST/

# Segreti: mai committare env locali.
.env
.env.*
!.env.example

# Artefatti della guida: gli screenshot si rigenerano con `npm run guide:shots`
# e il PDF con `npm run guide:pdf`. Tenere binari in un repo di testo li fa
# solo crescere a ogni rigenerazione.
scripts/guide/shots/
Guida-Pannello-Admin-AON.pdf

# Bundle generati da `npm run build`. Se la build fallisce il deploy fallisce e
# la produzione resta sull'ultima versione buona: meglio che committare artefatti
# che si riempiono di diff a ogni rigenerazione.
assets/
