{
  "name": "aon-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Andrea Onori — portfolio + CMS hard-coded (admin-edits) con save serverless sicuro via GitHub API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/prerender.mjs",
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "serve": "node scripts/guide/serve-mock.mjs --port 4000",
    "serve:demo": "node scripts/guide/serve-mock.mjs --port 4000 --fixtures",
    "guide:shots": "node scripts/guide/capture.mjs",
    "guide:pdf": "node scripts/guide/build-pdf.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "3.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
